# Pedidos online — copia este archivo a .env para desarrollo local.
# En producción, configura estas variables en Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). Sin estas variables, en local se usa una
# base de datos en memoria y el acceso al panel es dev/dev; en Vercel son
# OBLIGATORIAS (guardan pedidos y las cuentas del equipo).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
